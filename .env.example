# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Configuration
# VITE_SUPABASE_URL: Project URL from your Supabase Project Settings > API
VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY: Public Anon Key from Supabase Project Settings > API
VITE_SUPABASE_ANON_KEY=""

# Mercado Pago Integration (Access Token para PIX Automático)
# Obtenha em https://www.mercadopago.com.br/developers/panel/app (Credenciais de Produção ou Teste)
MERCADO_PAGO_ACCESS_TOKEN=""
